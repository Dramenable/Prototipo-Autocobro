@model CrudContactosMVC.Models.AutocobroViewModel

@{
    ViewData["Title"] = "Autocobro";
}

<style>
    #detectResult {
        min-height: 120px;
        white-space: pre-wrap;
    }

    #cameraModal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .camera-modal-content {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        padding: 14px;
    }

    #cameraVideo {
        width: 100%;
        border: 1px solid #ced4da;
        border-radius: 8px;
        background: #000;
    }

    .camera-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 10px;
    }
</style>

<div class="container mt-4">
    <h2>Autocobro</h2>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje) && !Model.Mensaje.Contains("registrad", StringComparison.OrdinalIgnoreCase))
    {
        <div id="statusAlert" class="alert @(Model.PagoRealizado ? "alert-success" : "alert-info")" role="alert">
            @Model.Mensaje
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody id="cartTableBody">
                    @if (Model.CartItems.Any())
                    {
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Nombre</td>
                                <td>@item.Precio.ToString("0.00")</td>
                                <td>@item.Cantidad</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">No hay productos registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 text-end">
            <h5>Subtotal: <span id="subtotalAmount">@((Model.Total * 0.84m).ToString("0.00"))</span></h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 text-end">
            <h5>IVA 16%: <span id="ivaAmount">@((Model.Total * 0.16m).ToString("0.00"))</span></h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 text-end">
            <h4>Total: <span id="totalAmount">@Model.Total.ToString("0.00")</span></h4>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-8 d-flex justify-content-end gap-2">
            <button type="button" id="cancelPurchaseBtn" class="btn btn-danger btn-lg">Cancelar compra</button>
            <button type="button" id="detectBtn" class="btn btn-primary btn-lg">Detectar Productos</button>
            <form id="payForm" asp-action="AutocobroPagar" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" id="payBtn" class="btn btn-success btn-lg" @(Model.CartItems.Any() ? null : "disabled")>PAGAR</button>
            </form>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-8">
            <h5>Respuesta JSON del API</h5>
            <pre id="detectResult" class="bg-light border rounded p-3">Esperando detección...</pre>
        </div>
    </div>

    <form id="detectForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

</div>

<div id="cameraModal" aria-hidden="true">
    <div class="camera-modal-content" role="dialog" aria-modal="true" aria-label="Captura de cámara">
        <video id="cameraVideo" autoplay playsinline muted></video>
        <canvas id="cameraCanvas" style="display:none;"></canvas>
        <div class="camera-actions">
            <button type="button" id="cameraCancelBtn" class="btn btn-outline-secondary">Cancelar</button>
            <button type="button" id="cameraConfirmBtn" class="btn btn-primary">Confirmar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const detectBtn = document.getElementById('detectBtn');
            const cameraModal = document.getElementById('cameraModal');
            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('cameraCanvas');
            const cameraConfirmBtn = document.getElementById('cameraConfirmBtn');
            const cameraCancelBtn = document.getElementById('cameraCancelBtn');
            const detectResult = document.getElementById('detectResult');
            const cartTableBody = document.getElementById('cartTableBody');
            const subtotalAmount = document.getElementById('subtotalAmount');
            const ivaAmount = document.getElementById('ivaAmount');
            const totalAmount = document.getElementById('totalAmount');
            const payForm = document.getElementById('payForm');
            const payBtn = document.getElementById('payBtn');
            const cancelPurchaseBtn = document.getElementById('cancelPurchaseBtn');
            const tokenInput = document.querySelector('#detectForm input[name="__RequestVerificationToken"]');
            let activeStream = null;
            let captureMode = 'detect';

            function formatMoney(value) {
                const num = Number(value);
                return Number.isNaN(num) ? '0.00' : num.toFixed(2);
            }

            function updateSummary(total) {
                const normalizedTotal = Number(total) || 0;
                subtotalAmount.textContent = formatMoney(normalizedTotal * 0.84);
                ivaAmount.textContent = formatMoney(normalizedTotal * 0.16);
                totalAmount.textContent = formatMoney(normalizedTotal);
            }

            function renderCart(cartItems, total) {
                cartTableBody.innerHTML = '';

                if (!cartItems || cartItems.length === 0) {
                    cartTableBody.innerHTML = '<tr><td colspan="4" class="text-center">No hay productos registrados</td></tr>';
                    updateSummary(0);
                    return;
                }

                cartItems.forEach(item => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${item.id}</td>
                        <td>${item.nombre}</td>
                        <td>${formatMoney(item.precio)}</td>
                        <td>${item.cantidad}</td>
                    `;

                    cartTableBody.appendChild(tr);
                });

                updateSummary(total);
            }

            async function openCameraModal() {
                try {
                    detectBtn.disabled = true;
                    if (payBtn) {
                        payBtn.disabled = true;
                    }
                    detectResult.textContent = 'Abriendo cámara...';

                    activeStream = await navigator.mediaDevices.getUserMedia({ video: true });
                    video.srcObject = activeStream;
                    cameraModal.style.display = 'flex';
                    cameraModal.setAttribute('aria-hidden', 'false');

                    await new Promise(resolve => {
                        video.onloadedmetadata = () => resolve();
                    });

                    detectResult.textContent = 'Cámara lista. Presiona Confirmar para capturar.';
                } catch (error) {
                    detectResult.textContent = `Error: ${error.message}`;
                    closeCameraModal();
                }
            }

            function closeCameraModal() {
                if (activeStream) {
                    activeStream.getTracks().forEach(track => track.stop());
                    activeStream = null;
                }

                video.srcObject = null;
                cameraModal.style.display = 'none';
                cameraModal.setAttribute('aria-hidden', 'true');
                cameraConfirmBtn.disabled = false;
                cameraCancelBtn.disabled = false;
                detectBtn.disabled = false;
                if (payBtn) {
                    payBtn.disabled = false;
                }
            }

            async function captureAndDetect() {
                if (!activeStream) {
                    return;
                }

                try {
                    cameraConfirmBtn.disabled = true;
                    cameraCancelBtn.disabled = true;

                    await new Promise(resolve => setTimeout(resolve, 400));

                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    const context = canvas.getContext('2d');
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);

                    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.92));
                    if (!blob) {
                        throw new Error('No se pudo capturar la imagen.');
                    }

                    const formData = new FormData();
                    formData.append('file', blob, 'captura.jpg');

                    detectResult.textContent = 'Enviando imagen al API...';

                    const url = captureMode === 'pay'
                        ? '@Url.Action("ValidarPagoConSegundaDeteccion", "Productos")'
                        : '@Url.Action("DetectarProductos", "Productos")';

                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': tokenInput.value
                        }
                    });

                    const responseText = await response.text();
                    let data;

                    try {
                        data = JSON.parse(responseText);
                    } catch {
                        detectResult.textContent = responseText;
                        return;
                    }

                    if (captureMode === 'pay') {
                        detectResult.textContent = data.responseJson ?? responseText;
                        if (!data.success) {
                            alert(data.mensaje || 'La segunda detección no coincide con la primera.');
                            return;
                        }

                        payForm.submit();
                        return;
                    }

                    detectResult.textContent = data.responseJson ?? responseText;
                    renderCart(data.cartItems, data.total);
                } catch (error) {
                    detectResult.textContent = `Error: ${error.message}`;
                } finally {
                    closeCameraModal();
                }
            }

            if (@Model.PagoRealizado.ToString().ToLowerInvariant()) {
                const statusAlert = document.getElementById('statusAlert');
                if (statusAlert) {
                    setTimeout(() => {
                        statusAlert.style.display = 'none';
                    }, 3000);
                }
            }

            detectBtn.addEventListener('click', () => {
                captureMode = 'detect';
                openCameraModal();
            });
            cameraConfirmBtn.addEventListener('click', captureAndDetect);
            cameraCancelBtn.addEventListener('click', closeCameraModal);
            payForm.addEventListener('submit', (e) => {
                e.preventDefault();
                captureMode = 'pay';
                openCameraModal();
            });
            cancelPurchaseBtn.addEventListener('click', () => {
                renderCart([], 0);
                detectResult.textContent = 'Esperando detección...';
            });
        })();
    </script>
}
