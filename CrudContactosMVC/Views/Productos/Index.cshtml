@model IEnumerable<CrudContactosMVC.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Crear" class="btn btn-primary">Crear nuevo</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td>@item.Precio.ToString("F2")</td>
            <td>@item.Cantidad</td>
            <td>
                <a asp-action="Editar"
                   asp-route-id="@item.Id"
                   class="btn btn-warning btn-sm">
                    Editar
                </a>

                <a asp-action="Detalle"
                   asp-route-id="@item.Id"
                   class="btn btn-info btn-sm">
                    Detalle
                </a>

                <a asp-action="Borrar"
                   asp-route-id="@item.Id"
                   class="btn btn-danger btn-sm">
                    Eliminar
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
